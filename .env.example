# BrainVault / BrainVuln deployment environment variables (example)
# Copy to .env (backend) and fill in. NEVER commit real secrets.

# ---------------------------------------------------------------------------
# Inference backend (service/app.py on Render/Railway/Cloud Run/Docker)
# ---------------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API (CORS).
BRAINVULN_CORS_ORIGINS=https://brain-vault.vercel.app,https://brain-vault-*.vercel.app

# Upper bound for uploaded volumes, in MB (server-enforced, 413 beyond it).
BRAINVULN_MAX_UPLOAD_MB=200

# Path overrides (defaults shown; usually leave unset)
# BRAINVULN_ATLAS_IMG=data/derived/atlas_dk68_tianS1.nii.gz
# BRAINVULN_ATLAS_INFO=data/derived/atlas_dk68_tianS1_info.csv

# ---------------------------------------------------------------------------
# Checkpoint bootstrap (hosts that build from the repo: Render/Railway/CR)
# ---------------------------------------------------------------------------
# The 128 MB frozen checkpoint is NOT in git and must never be public.
# Point this at a PRIVATE copy of best.pt (pre-signed S3/GCS URL, or a
# token-authenticated URL). Its SHA256 is verified against
# 5930f0fff96003466a9a2854037ea8758b2b77be49159b7101f4fabbf254a4a9
# before anything is served; a mismatch aborts startup.
BRAINVULN_CHECKPOINT_URL=
BRAINVULN_CHECKPOINT_TOKEN=

# Port the service listens on (Render/Railway set this themselves).
PORT=8000
